
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================
    // 1. AUTHENTICATION
    // =====================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    // Admin must have a trusted Custom Claim.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }


    // =====================================
    // 2. USER PROFILE VALIDATION
    // =====================================

    function validUserProfile(userId) {
      return request.resource.data.keys().hasAll([
        'uid',
        'fullName',
        'email',
        'phone',
        'role',
        'createdAt'
      ])
      &&
      request.resource.data.keys().hasOnly([
        'uid',
        'fullName',
        'email',
        'phone',
        'role',
        'createdAt'
      ])
      &&
      request.resource.data.uid == userId
      &&
      request.resource.data.fullName is string
      &&
      request.resource.data.fullName.size() > 0
      &&
      request.resource.data.fullName.size() <= 100
      &&
      request.resource.data.email is string
      &&
      request.resource.data.email == request.auth.token.email
      &&
      request.resource.data.phone is string
      &&
      request.resource.data.phone.size() > 0
      &&
      request.resource.data.phone.size() <= 20
      &&
      request.resource.data.role == 'user'
      &&
      request.resource.data.createdAt == request.time;
    }


    // =====================================
    // 3. BOOKING VALIDATION
    // =====================================

    function validBooking() {
      return request.resource.data.keys().hasAll([
        'uid',
        'clientName',
        'clientEmail',
        'clientPhone',
        'service',
        'date',
        'time',
        'notes',
        'status',
        'createdAt'
      ])
      &&
      request.resource.data.keys().hasOnly([
        'uid',
        'clientName',
        'clientEmail',
        'clientPhone',
        'service',
        'date',
        'time',
        'notes',
        'status',
        'createdAt'
      ])
      &&
      request.resource.data.uid == request.auth.uid
      &&
      request.resource.data.clientName is string
      &&
      request.resource.data.clientName.size() > 0
      &&
      request.resource.data.clientName.size() <= 100
      &&
      request.resource.data.clientEmail is string
      &&
      request.resource.data.clientEmail == request.auth.token.email
      &&
      request.resource.data.clientPhone is string
      &&
      request.resource.data.clientPhone.size() > 0
      &&
      request.resource.data.clientPhone.size() <= 20
      &&
      request.resource.data.service is string
      &&
      (
        request.resource.data.service == 'Business Consultation'
        ||
        request.resource.data.service == 'Website Development'
        ||
        request.resource.data.service == 'Project Discussion'
        ||
        request.resource.data.service == 'Technical Support'
        ||
        request.resource.data.service == 'Other Service'
      )
      &&
      request.resource.data.date is string
      &&
      request.resource.data.date.matches(
        '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
      )
      &&
      request.resource.data.time is string
      &&
      request.resource.data.time.matches(
        '^([01][0-9]|2[0-3]):[0-5][0-9]$'
      )
      &&
      request.resource.data.notes is string
      &&
      request.resource.data.notes.size() <= 1000
      &&
      request.resource.data.status == 'Pending'
      &&
      request.resource.data.createdAt == request.time;
    }


    // =====================================
    // 4. USERS COLLECTION
    // =====================================

    match /users/{userId} {

      // Read own profile or admin read.
      allow read: if isOwner(userId) || isAdmin();

      // Create own profile only.
      allow create: if isOwner(userId)
        && validUserProfile(userId);

      // Update only name and phone.
      allow update: if (
        isOwner(userId) || isAdmin()
      )
      &&
      request.resource.data.keys().hasAll([
        'uid',
        'fullName',
        'email',
        'phone',
        'role',
        'createdAt'
      ])
      &&
      request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['fullName', 'phone'])
      &&
      request.resource.data.fullName is string
      &&
      request.resource.data.fullName.size() > 0
      &&
      request.resource.data.fullName.size() <= 100
      &&
      request.resource.data.phone is string
      &&
      request.resource.data.phone.size() > 0
      &&
      request.resource.data.phone.size() <= 20;

      // No profile deletion.
      allow delete: if false;
    }


    // =====================================
    // 5. BOOKINGS COLLECTION
    // =====================================

    match /bookings/{bookingId} {

      // User reads own bookings.
      // Admin reads all bookings.
      allow read: if isAdmin()
        ||
        (
          isSignedIn()
          && resource.data.uid == request.auth.uid
        );

      // Create own booking only.
      allow create: if isSignedIn()
        && validBooking();

      // Only admin can update booking status.
      allow update: if isAdmin()
        &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['status'])
        &&
        (
          request.resource.data.status == 'Pending'
          ||
          request.resource.data.status == 'Approved'
          ||
          request.resource.data.status == 'Rejected'
          ||
          request.resource.data.status == 'Cancelled'
        );

      // No booking deletion.
      allow delete: if false;
    }


    // =====================================
    // 6. DEFAULT SECURITY
    // =====================================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
