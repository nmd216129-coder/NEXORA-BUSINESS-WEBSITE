
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // USER PROFILE VALIDATION
    function validUserProfile(userId) {
      return request.resource.data.keys().hasAll([
        'uid',
        'fullName',
        'email',
        'phone',
        'role',
        'createdAt'
      ])
      &&
      request.resource.data.keys().hasOnly([
        'uid',
        'fullName',
        'email',
        'phone',
        'role',
        'createdAt'
      ])
      &&
      request.resource.data.uid == userId
      &&
      request.resource.data.fullName is string
      &&
      request.resource.data.fullName.size() > 0
      &&
      request.resource.data.fullName.size() <= 100
      &&
      request.resource.data.email == request.auth.token.email
      &&
      request.resource.data.phone is string
      &&
      request.resource.data.phone.size() <= 20
      &&
      request.resource.data.role == 'user'
      &&
      request.resource.data.createdAt == request.time;
    }

    // BOOKING VALIDATION
    function validBooking() {
      return request.resource.data.keys().hasAll([
        'uid',
        'clientName',
        'clientEmail',
        'clientPhone',
        'service',
        'date',
        'time',
        'notes',
        'status',
        'createdAt'
      ])
      &&
      request.resource.data.keys().hasOnly([
        'uid',
        'clientName',
        'clientEmail',
        'clientPhone',
        'service',
        'date',
        'time',
        'notes',
        'status',
        'createdAt'
      ])
      &&
      request.resource.data.uid == request.auth.uid
      &&
      request.resource.data.clientName is string
      &&
      request.resource.data.clientName.size() > 0
      &&
      request.resource.data.clientName.size() <= 100
      &&
      request.resource.data.clientEmail is string
      &&
      request.resource.data.clientEmail == request.auth.token.email
      &&
      request.resource.data.clientPhone is string
      &&
      request.resource.data.clientPhone.size() > 0
      &&
      request.resource.data.clientPhone.size() <= 20
      &&
      request.resource.data.service in [
        'Business Consultation',
        'Website Development',
        'Project Discussion',
        'Technical Support',
        'Other Service'
      ]
      &&
      request.resource.data.date is string
      &&
      request.resource.data.date.matches(
        '^\\d{4}-\\d{2}-\\d{2}$'
      )
      &&
      request.resource.data.time is string
      &&
      request.resource.data.time.matches(
        '^([01]\\d|2[0-3]):[0-5]\\d$'
      )
      &&
      request.resource.data.notes is string
      &&
      request.resource.data.notes.size() <= 1000
      &&
      request.resource.data.status == 'Pending'
      &&
      request.resource.data.createdAt == request.time;
    }

    // USER PROFILES
    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validUserProfile(userId);

      // Users may update only their name and phone.
      // UID, email, role and createdAt remain protected.
      allow update: if isOwner(userId)
        &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['fullName', 'phone'])
        &&
        request.resource.data.fullName is string
        &&
        request.resource.data.fullName.size() > 0
        &&
        request.resource.data.fullName.size() <= 100
        &&
        request.resource.data.phone is string
        &&
        request.resource.data.phone.size() <= 20;

      allow delete: if false;
    }

    // BOOKINGS
    match /bookings/{bookingId} {

      // Users can read only their own bookings.
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      // Users can create bookings for themselves.
      allow create: if isSignedIn()
        && validBooking();

      // Booking updates and deletion are disabled.
      allow update, delete: if false;
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
